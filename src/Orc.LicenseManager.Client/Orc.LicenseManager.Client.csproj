<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Orc.LicenseManager.Client</AssemblyName>
    <RootNamespace>Orc.LicenseManager</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PackageId>Orc.LicenseManager.Client</PackageId>
    <PackageVersion>1.0.0-alpha0001</PackageVersion>
    <Description>LicenseManager - client library.</Description>
    <PackageTags>orc;license;client</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SonarQube requires a project guid -->
    <ProjectGuid>673E6FB6-2042-44D0-9767-A41B45DAD42E</ProjectGuid>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Catel.Fody" Version="7.1.0-alpha0016" PrivateAssets="all" />
    <PackageReference Include="Catel.SourceGenerators" Version="7.0.1" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.1.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LoadAssembliesOnStartup.Fody" Version="4.7.0" PrivateAssets="all" />
    <PackageReference Include="MethodTimer.Fody" Version="3.2.3" PrivateAssets="all" />
    <PackageReference Include="Obsolete.Fody" Version="5.3.1" PrivateAssets="all" />
    <PackageReference Include="Orc.FileSystem" Version="6.0.0-alpha0123" />
    <PackageReference Include="Orc.Serialization.Json" Version="6.0.0-alpha0105" />
    <PackageReference Include="Orc.SystemInfo" Version="6.0.0-alpha0092" />
    <PackageReference Include="Portable.Licensing" Version="1.1.0" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.nullable.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.nullable.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props')" />
</Project>
